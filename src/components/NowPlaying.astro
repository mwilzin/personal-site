---
const profileUrl = 'https://www.last.fm/user/mwilzin';
const apiKey = import.meta.env.PUBLIC_LASTFM_API_KEY ?? '';
---

<div
  class="np-root"
  data-now-playing
  data-api-key={apiKey}
  data-user="mwilzin"
  data-profile={profileUrl}
  hidden
>
  <a
    href={profileUrl}
    target="_blank"
    rel="noopener"
    class="np-island"
    data-np-island
    aria-label="Last.fm — jetzt hören"
  >
    <img data-np-art alt="" width="40" height="40" class="np-island-art" />
    <span class="np-island-meta">
      <span data-np-title class="np-island-title"></span>
      <span data-np-artist class="np-island-artist"></span>
    </span>
    <span data-np-eq aria-hidden="true" class="np-eq np-island-eq">
      <span class="np-eq-bar"></span>
      <span class="np-eq-bar"></span>
      <span class="np-eq-bar"></span>
      <span class="np-eq-bar"></span>
      <span class="np-eq-bar"></span>
    </span>
  </a>
</div>

<style>
  /* Fixed overlay — never shifts document flow / CLS when it appears */
  .np-root {
    display: flex;
    position: fixed;
    top: 0.65rem;
    left: 50%;
    z-index: 40;
    justify-content: center;
    width: max-content;
    max-width: calc(100vw - 1.5rem);
    pointer-events: none;
    transform: translateX(-50%);
  }

  .np-island {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    gap: 0;
    /* Same shell width as the open island without art + eq */
    width: calc(12.25rem - (1.95rem - 2px) - 4px - 0.65rem - 1.35rem);
    height: 2.5rem;
    padding: 0.3rem 0.9rem;
    overflow: hidden;
    border-radius: 9999px;
    background: #0a0a0a;
    color: #f5f5f5;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.35),
      0 12px 32px -14px rgb(0 0 0 / 0.65);
    outline: 1px solid rgb(255 255 255 / 0.08);
    text-decoration: none;
    pointer-events: auto;
    opacity: 0;
    transform: scale(0.7);
    transition:
      width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      gap 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      justify-content 0.55s,
      opacity 0.35s ease,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Phase 1: empty bubble pops in */
  .np-root[data-phase='bubble'] .np-island,
  .np-root[data-phase='open'] .np-island {
    opacity: 1;
    transform: scale(1);
  }

  /* Phase 2: bubble widens; art + eq slide to the sides */
  .np-root[data-phase='open'] .np-island {
    width: 12.25rem;
    gap: 0.65rem;
    justify-content: flex-start;
    padding: 0.3rem 0.9rem 0.3rem 0.45rem;
  }

  .np-island-art {
    width: 0;
    height: calc(1.95rem - 2px);
    flex-shrink: 0;
    margin-left: 0;
    border-radius: 0.5rem;
    object-fit: cover;
    opacity: 0;
    transform: translateX(14px) scale(0.55);
    transition:
      width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease 0.05s,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .np-root[data-phase='open'] .np-island-art {
    width: calc(1.95rem - 2px);
    margin-left: 4px;
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .np-island-meta {
    display: grid;
    min-width: 0;
    flex: 1;
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    transition:
      opacity 0.25s ease,
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .np-island-title {
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-island-artist {
    font-size: 0.65rem;
    color: rgb(255 255 255 / 0.55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-island-eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 0.9rem;
    flex-shrink: 0;
    margin-left: 0;
    color: #ff6b4a;
    width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-14px) scale(0.55);
    transition:
      width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      max-width 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease 0.05s,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .np-island-eq[data-active='true'] {
    display: inline-flex;
  }

  .np-root[data-phase='open'] .np-island-eq[data-active='true'] {
    width: auto;
    max-width: 2rem;
    margin-left: auto;
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  /* Must beat `.np-root[data-phase='open'] .np-island` specificity */
  .np-root[data-phase='open'] .np-island[data-expanded='true'] {
    width: min(92vw, 22rem);
    height: 3.15rem;
    gap: 0.75rem;
    padding: 0.35rem 0.95rem 0.35rem 0.4rem;
  }

  .np-root[data-phase='open'] .np-island[data-expanded='true'] .np-island-art {
    width: 2.25rem;
    height: 2.25rem;
  }

  .np-root[data-phase='open'] .np-island[data-expanded='true'] .np-island-meta {
    opacity: 1;
    max-width: 14rem;
  }

  .np-eq-bar {
    display: block;
    width: 2.5px;
    height: 100%;
    border-radius: 999px;
    background: currentColor;
    color: inherit;
    transform: scaleY(0.22);
    transform-origin: bottom center;
    will-change: transform;
  }

  .np-island-eq[data-active='true'] .np-eq-bar:nth-child(1) {
    animation: np-eq-1 1.45s linear infinite;
  }
  .np-island-eq[data-active='true'] .np-eq-bar:nth-child(2) {
    animation: np-eq-2 1.15s linear infinite;
  }
  .np-island-eq[data-active='true'] .np-eq-bar:nth-child(3) {
    animation: np-eq-3 1.7s linear infinite;
  }
  .np-island-eq[data-active='true'] .np-eq-bar:nth-child(4) {
    animation: np-eq-4 1.3s linear infinite;
  }
  .np-island-eq[data-active='true'] .np-eq-bar:nth-child(5) {
    animation: np-eq-5 1.55s linear infinite;
  }

  /* scaleY keeps EQ on the compositor (height animation would not) */
  @keyframes np-eq-1 {
    0% {
      transform: scaleY(0.22);
    }
    15% {
      transform: scaleY(0.7);
    }
    30% {
      transform: scaleY(0.35);
    }
    45% {
      transform: scaleY(0.95);
    }
    60% {
      transform: scaleY(0.28);
    }
    75% {
      transform: scaleY(0.55);
    }
    100% {
      transform: scaleY(0.22);
    }
  }

  @keyframes np-eq-2 {
    0% {
      transform: scaleY(0.55);
    }
    12% {
      transform: scaleY(0.9);
    }
    28% {
      transform: scaleY(0.25);
    }
    40% {
      transform: scaleY(0.65);
    }
    55% {
      transform: scaleY(1);
    }
    70% {
      transform: scaleY(0.4);
    }
    85% {
      transform: scaleY(0.75);
    }
    100% {
      transform: scaleY(0.55);
    }
  }

  @keyframes np-eq-3 {
    0% {
      transform: scaleY(0.8);
    }
    18% {
      transform: scaleY(0.3);
    }
    32% {
      transform: scaleY(1);
    }
    48% {
      transform: scaleY(0.45);
    }
    62% {
      transform: scaleY(0.7);
    }
    78% {
      transform: scaleY(0.2);
    }
    100% {
      transform: scaleY(0.8);
    }
  }

  @keyframes np-eq-4 {
    0% {
      transform: scaleY(0.35);
    }
    20% {
      transform: scaleY(0.85);
    }
    35% {
      transform: scaleY(0.5);
    }
    50% {
      transform: scaleY(0.25);
    }
    65% {
      transform: scaleY(0.95);
    }
    82% {
      transform: scaleY(0.4);
    }
    100% {
      transform: scaleY(0.35);
    }
  }

  @keyframes np-eq-5 {
    0% {
      transform: scaleY(0.45);
    }
    14% {
      transform: scaleY(0.2);
    }
    28% {
      transform: scaleY(0.75);
    }
    42% {
      transform: scaleY(0.55);
    }
    58% {
      transform: scaleY(1);
    }
    72% {
      transform: scaleY(0.3);
    }
    88% {
      transform: scaleY(0.65);
    }
    100% {
      transform: scaleY(0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-island,
    .np-island-art,
    .np-island-meta,
    .np-island-eq {
      transition: none;
    }

    .np-island,
    .np-island-art,
    .np-island-eq {
      transform: none;
    }

    .np-root[data-phase='bubble'] .np-island,
    .np-root[data-phase='open'] .np-island,
    .np-root[data-phase='open'] .np-island-art,
    .np-root[data-phase='open'] .np-island-eq[data-active='true'] {
      transform: none;
    }

    .np-island-eq[data-active='true'] .np-eq-bar {
      animation: none;
      transform: scaleY(0.55);
    }
  }
</style>

<script>
  type TrackImage = { size: string; '#text': string };
  type RecentTrack = {
    name: string;
    artist: { '#text': string };
    image: TrackImage[];
    '@attr'?: { nowplaying?: string };
  };

  const root = document.querySelector<HTMLElement>('[data-now-playing]');
  if (root) {
    const apiKey = root.dataset.apiKey || '';
    const user = root.dataset.user || 'mwilzin';
    const island = root.querySelector<HTMLAnchorElement>('[data-np-island]');
    const art = root.querySelector<HTMLImageElement>('[data-np-art]');
    const title = root.querySelector<HTMLElement>('[data-np-title]');
    const artist = root.querySelector<HTMLElement>('[data-np-artist]');
    const eq = root.querySelector<HTMLElement>('[data-np-eq]');

    let hasEntered = false;

    const hide = () => {
      root.hidden = true;
      root.dataset.ready = 'false';
      root.dataset.phase = '';
      hasEntered = false;
    };

    const showTrack = (track: RecentTrack) => {
      const nowPlaying = track['@attr']?.nowplaying === 'true';
      const image =
        [...(track.image || [])].reverse().find((img) => img['#text'])?.['#text'] || '';
      if (!nowPlaying || !image) {
        hide();
        return;
      }

      const trackName = track.name || 'Unbekannter Titel';
      const artistName = track.artist?.['#text'] || 'Unbekannter Artist';

      if (art) {
        art.src = image;
        art.alt = `Cover: ${trackName}`;
      }
      if (title) title.textContent = trackName;
      if (artist) artist.textContent = artistName;
      if (eq) eq.dataset.active = 'true';

      if (hasEntered) {
        root.hidden = false;
        root.dataset.ready = 'true';
        root.dataset.phase = 'open';
        return;
      }

      // 1) wait → 2) bubble pops in → 3) art + eq slide out as it widens
      window.setTimeout(() => {
        root.hidden = false;
        root.dataset.phase = '';
        root.dataset.ready = 'false';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            root.dataset.ready = 'true';
            root.dataset.phase = 'bubble';
            window.setTimeout(() => {
              root.dataset.phase = 'open';
              hasEntered = true;
            }, 320);
          });
        });
      }, 650);
    };

    const fetchTrack = async () => {
      if (!apiKey) {
        hide();
        return;
      }

      try {
        const url = new URL('https://ws.audioscrobbler.com/2.0/');
        url.searchParams.set('method', 'user.getrecenttracks');
        url.searchParams.set('user', user);
        url.searchParams.set('api_key', apiKey);
        url.searchParams.set('limit', '1');
        url.searchParams.set('format', 'json');

        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const tracks = data?.recenttracks?.track;
        const track: RecentTrack | undefined = Array.isArray(tracks) ? tracks[0] : tracks;
        if (!track?.name) throw new Error('No track');
        showTrack(track);
      } catch {
        hide();
      }
    };

    // First click expands details; second click follows Last.fm
    if (island) {
      island.addEventListener('click', (event) => {
        if (island.dataset.expanded === 'true') return;
        event.preventDefault();
        island.dataset.expanded = 'true';
      });

      document.addEventListener('pointerdown', (event) => {
        if (!(event.target instanceof Node)) return;
        if (!island.contains(event.target)) {
          island.dataset.expanded = 'false';
        }
      });
    }

    // Defer Last.fm until after first paint so it never races LCP/SI
    const scheduleFetch = () => {
      const run = () => fetchTrack();
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 2500 });
      } else {
        window.setTimeout(run, 1200);
      }
    };

    if (document.readyState === 'complete') scheduleFetch();
    else window.addEventListener('load', scheduleFetch, { once: true });

    let timer = 0;
    const start = () => {
      if (timer || !apiKey) return;
      timer = window.setInterval(() => {
        if (document.visibilityState === 'visible') fetchTrack();
      }, 60_000);
    };
    const stop = () => {
      if (!timer) return;
      clearInterval(timer);
      timer = 0;
    };

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        fetchTrack();
        start();
      } else {
        stop();
      }
    });
    start();
  }
</script>
