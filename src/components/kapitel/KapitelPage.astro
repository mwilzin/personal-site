---
import Layout from '~/layouts/Layout.astro';
import '~/styles/kapitel-pages.css';

export interface Props {
  title: string;
  description: string;
  centered?: boolean;
}

const { title, description, centered = false } = Astro.props;
---

<Layout
  metadata={{
    title,
    description,
    ignoreTitleTemplate: true,
    robots: { index: true, follow: true },
  }}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <main class="kapitel-page">
    <div class="kapitel-glow" aria-hidden="true"></div>
    <div class:list={['kapitel-inner', centered && 'kapitel-inner--center']}>
      <slot />
    </div>
  </main>
</Layout>
