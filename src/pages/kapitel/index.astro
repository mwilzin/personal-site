---
import Layout from '~/layouts/Layout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Kapitel',
  description: 'Kapitel — die Study-App für Uni, Fokus und Kursmaterial. Support und rechtliche Hinweise.',
  ignoreTitleTemplate: true,
  robots: {
    index: true,
    follow: true,
  },
};

const supportEmail = 'kapitel@mwilzin.de';
const impressumHref = getPermalink('/impressum');
const datenschutzHref = getPermalink('/kapitel/datenschutz');
---

<Layout metadata={metadata}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <main class="kapitel-landing">
    <div class="kapitel-glow" aria-hidden="true"></div>

    <div class="kapitel-inner">
      <p class="kapitel-eyebrow">Study app</p>
      <h1 class="kapitel-brand">Kapitel</h1>
      <p class="kapitel-lead">
        Deine Kurse, Fristen und Fokus-Sessions an einem Ort. Für iPhone, iPad und Mac.
      </p>

      <div class="kapitel-actions">
        <a class="kapitel-cta" href={`mailto:${supportEmail}`}>Support schreiben</a>
        <a class="kapitel-secondary" href={impressumHref}>Impressum</a>
      </div>

      <p class="kapitel-meta">
        Oder direkt an
        <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
        ·
        <a href={datenschutzHref}>Datenschutz</a>
      </p>
    </div>
  </main>
</Layout>

<style is:global>
  /* Keep this page readable even if shared theme CSS fails to load. */
  body:has(.kapitel-landing) {
    margin: 0;
    background: #ebe6dc;
  }

  .kapitel-landing {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    font-family: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    color: #1c1a16;
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(46, 102, 105, 0.18), transparent 55%),
      radial-gradient(900px 500px at 100% 0%, rgba(201, 162, 39, 0.12), transparent 50%),
      linear-gradient(180deg, #f4f1ea 0%, #ebe6dc 100%);
  }

  .kapitel-glow {
    position: absolute;
    right: -20%;
    bottom: -30%;
    width: min(70vw, 520px);
    height: min(70vw, 520px);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(46, 102, 105, 0.22), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
  }

  .kapitel-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    max-width: 44rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .kapitel-eyebrow {
    margin: 0 0 1.1rem;
    color: #2e6669;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .kapitel-brand {
    margin: 0 0 1rem;
    font-family: Fraunces, Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }

  .kapitel-lead {
    margin: 0 0 2.25rem;
    max-width: 36rem;
    color: #4a463e;
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    line-height: 1.55;
  }

  .kapitel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .kapitel-cta,
  .kapitel-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.2;
  }

  .kapitel-cta {
    color: #fff;
    background: #2e6669;
  }

  .kapitel-cta:hover {
    opacity: 0.92;
  }

  .kapitel-secondary {
    color: #1c1a16;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(28, 26, 22, 0.14);
  }

  .kapitel-secondary:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .kapitel-meta {
    margin: 1.75rem 0 0;
    color: #6b655a;
    font-size: 0.95rem;
  }

  .kapitel-meta a {
    color: #2e6669;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
