---
import KapitelPage from '~/components/kapitel/KapitelPage.astro';
import { getPermalink } from '~/utils/permalinks';

const supportEmail = 'kapitel@mwilzin.de';
const impressumHref = getPermalink('/impressum');
const datenschutzHref = getPermalink('/kapitel/datenschutz');
---

<KapitelPage
  title="Kapitel"
  description="Kapitel — die Study-App für Uni, Fokus und Kursmaterial. Support und rechtliche Hinweise."
  centered
>
  <p class="kapitel-eyebrow">Study app</p>
  <h1 class="kapitel-brand">Kapitel</h1>
  <p class="kapitel-lead">
    Deine Kurse, Fristen und Fokus-Sessions an einem Ort. Für iPhone, iPad und Mac.
  </p>

  <div class="kapitel-actions">
    <a class="kapitel-cta" href={`mailto:${supportEmail}`}>Support schreiben</a>
    <a class="kapitel-secondary" href={impressumHref}>Impressum</a>
  </div>

  <p class="kapitel-meta">
    Oder direkt an
    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
    ·
    <a href={datenschutzHref}>Datenschutz</a>
  </p>
</KapitelPage>
