---
import BentoLayout from '~/layouts/BentoLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const timeline = [
  {
    title: 'Einzelunternehmen',
    description:
      'Seit 14.09.2026: App- und Softwareentwicklung auf eigene Rechnung. Aktuelles Produkt: Kapitel.',
  },
  {
    title: 'B.Sc. Informatik',
    description:
      'Eberhard Karls Universität Tübingen (seit Sept. 2024). MINT-Studienbotschafter der Mathematisch-Naturwissenschaftlichen Fakultät (seit 2025).',
  },
  {
    title: 'Programmierung & Softwareentwicklung',
    description:
      'page one GmbH, Nürnberg (10/2021 – 08/2026): scannerbox.mobile (Flutter, iOS & Android), DATEV-Anbindungen, CarPlay, CI/CD, RevenueCat, Sentry — Planung, UI und Umsetzung.',
  },
  {
    title: 'Praktikum iOS-Entwicklung',
    description:
      'EXARING AG / waipu.tv, München (25.–29.04.2022): Einblick in iOS & tvOS Entwicklung eines Scrum-Teams.',
  },
  {
    title: 'Abitur',
    description: 'Theresien Gymnasium Ansbach, Note 2,3 (Juni 2024).',
  },
];

const skills = [
  { title: 'Flutter / Dart', level: 'Schwerpunkt' },
  { title: 'Swift / SwiftUI / CarPlay', level: 'Praxis' },
  { title: 'Node.js · TypeScript', level: 'Praxis' },
  { title: 'Serverless · Cloudflare · Supabase · Firebase', level: 'Praxis' },
  { title: 'Datenbanken · SQL · MariaDB · Postgres', level: 'Praxis' },
  { title: 'CI/CD · Docker · Sentry', level: 'Praxis' },
  { title: 'Englisch', level: 'C1' },
];

const projects = [
  {
    title: 'Kapitel',
    description:
      'Native Study-App für iPhone, iPad & Mac: Kurse, Fristen, Karteikarten, Fokus-Timer, Synchronisierung von Moodle/Ilias/Stud.IP Inhalten.\nBackend auf Cloudflare (Workers, R2, D1, Access, DNS).',
    href: 'https://getkapitel.app',
  },
  {
    title: 'TVL Tennis',
    description:
      'Vereins-App für TV Leutershausen: Platzbuchung, News, Kalender, Chats, Partner-Suche, BTV-Spielplan-Sync.',
    href: 'https://tennis-tvl.de',
  },
  {
    title: 'scannerbox.mobile',
    description:
      'Dokumentenerfassung mit Kamera und Netzwerk-Hardwarescanner (z. B. Kopierer), DATEV-Schnittstellen zu Unternehmen online, Meine Steuern und Personalakte. CI/CD, Sentry, RevenueCat.',
    href: 'https://scannerbox.de',
  },
  {
    title: 'Page One App (intern)',
    description:
      'Interne Flutter-App bei page one: KI-Assistent, CarPlay, Kunden, Termine, Disposition und Maps.',
    href: 'https://www.page-one.de',
  },
  {
    title: 'KirchenANführer',
    description:
      'Interaktiver Guide für St. Gumbertus & St. Johannis (Ansbach): Solo-/Gruppentouren, Quiz-Typen, GPS & Indoor-Karten, Firebase — technischer Leiter im P-Seminar, Bayerischer P-Seminar-Preis.',
    href: 'https://apps.apple.com/app/kirchenanf%C3%BChrer/id6469477611',
  },
  {
    title: 'Ferienwohnungs-Verwaltung',
    description: 'Smoobu-Webhooks → Nuki-Zugangscodes, Reinigungspläne.\nNode.js, Flutter, Supabase.',
    href: 'https://www.stadtsterne.com',
  },
];
---

<BentoLayout
  metadata={{
    title: 'Über mich — Marc-Aurel Wilzin',
    description: 'Werdegang als App- und Softwareentwickler & Informatik-Student in Tübingen.',
  }}
>
  <main class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-4 p-4 md:p-6 lg:gap-6 lg:p-8">
    <a href={getPermalink('/')} class="text-sm text-muted transition-colors hover:text-fg"> ← Zurück </a>

    <section class="grid grid-cols-1 gap-4 lg:grid-cols-6 lg:gap-6">
      <div class="tile p-7 md:col-span-4 md:p-9">
        <p class="text-xs font-semibold tracking-wider text-kapitel uppercase">Über mich</p>
        <h1 class="font-display mt-2 text-4xl font-semibold md:text-5xl">
          App- &amp; Softwareentwicklung<br />
          <span class="text-accent-gradient">in der Praxis</span>
        </h1>
        <p class="mt-4 max-w-[60ch] text-muted">
          Seit September 2026 führe ich mein Einzelunternehmen und entwickle Kapitel: mein aktuelles Projekt von
          Student für Studenten. Davor habe ich von 2021 bis 2026 bei page one zwei Apps mit DATEV-Anbindung
          überwiegend allein geplant, gestaltet und umgesetzt.
        </p>
      </div>

      <div class="tile p-7 md:col-span-2 md:p-9">
        <h2 class="font-display text-2xl font-semibold">Skills</h2>
        <ul class="mt-4 space-y-3">
          {
            skills.map((skill) => (
              <li class="flex items-baseline justify-between gap-3 text-sm">
                <span class="text-fg">{skill.title}</span>
                <span class="text-muted-strong">{skill.level}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="tile p-7 md:p-9">
      <h2 class="font-display text-2xl font-semibold">Timeline</h2>
      <ol class="mt-6 space-y-5">
        {
          timeline.map((item) => (
            <li class="grid gap-1 border-l border-muted-strong pl-4">
              <h3 class="font-medium text-fg-strong">{item.title}</h3>
              <p class="text-sm text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="tile p-7 md:p-9">
      <h2 class="font-display text-2xl font-semibold">Projekte & Engagement</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          projects.map((project) => (
            <div>
              <h3 class="font-medium text-fg-strong">
                {project.href ? (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener"
                    class="underline decoration-muted-strong underline-offset-4 transition-colors hover:text-fg"
                  >
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>
              <p class="mt-1 whitespace-pre-line text-sm text-muted">{project.description}</p>
            </div>
          ))
        }
        <div>
          <h3 class="font-medium text-fg-strong">Engagement</h3>
          <p class="mt-1 text-sm text-muted">
            MINT-Studienbotschafter Uni Tübingen · Redebeiträge am Holocaust-Gedenktag Ansbach (2023–2025).
          </p>
        </div>
      </div>
    </section>
  </main>
</BentoLayout>
