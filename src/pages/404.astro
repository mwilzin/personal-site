---
import BentoLayout from '~/layouts/BentoLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
---

<BentoLayout
  metadata={{
    title: 'Seite nicht gefunden — Marc-Aurel Wilzin',
    description: 'Diese Seite gibt es nicht. Zurück zur Startseite von Marc-Aurel Wilzin.',
  }}
>
  <main class="mx-auto flex min-h-dvh w-full max-w-6xl flex-col items-center justify-center gap-6 px-6 py-16 text-center">
    <h1 class="font-display text-7xl leading-none font-semibold md:text-8xl">
      <span class="sr-only">Fehler </span>
      <span class="text-accent-gradient">404</span>
    </h1>
    <p class="max-w-[32ch] text-muted">Seite nicht gefunden.</p>
    <a href={getHomePermalink()} class="text-sm text-muted transition-colors hover:text-fg">
      ← Zur Startseite
    </a>
  </main>
</BentoLayout>
