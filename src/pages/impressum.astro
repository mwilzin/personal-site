---
import KapitelPage from '~/components/kapitel/KapitelPage.astro';
import { getPermalink } from '~/utils/permalinks';

const imprintEmail = 'marc@mwilzin.de';
---

<KapitelPage
  title="Impressum"
  description="Impressum und Anbieterkennzeichnung für mwilzin.de und die App Kapitel."
>
  <nav class="kapitel-nav">
    <a href={getPermalink('/kapitel')}>← Zurück zu Kapitel</a>
  </nav>

  <p class="kapitel-eyebrow">Rechtliches</p>
  <h1 class="kapitel-brand kapitel-brand--doc">Impressum</h1>
  <p class="kapitel-lead">Angaben gemäß § 5 DDG (Digitale-Dienste-Gesetz)</p>

  <div class="kapitel-prose">
    <h2>Anbieter</h2>
    <p>
      <strong>Marc-Aurel Wilzin</strong><br />
      E-Mail: <a href={`mailto:${imprintEmail}`}>{imprintEmail}</a>
    </p>
    <p>Verantwortlich für die Inhalte dieser Website sowie für die App <strong>Kapitel</strong>.</p>

    <h2>Kontakt</h2>
    <p>
      Allgemeine Anfragen:<br />
      <a href={`mailto:${imprintEmail}`}>{imprintEmail}</a>
    </p>
    <p>
      Support zur App Kapitel:<br />
      <a href="mailto:kapitel@mwilzin.de">kapitel@mwilzin.de</a>
    </p>

    <h2>Haftung für Inhalte</h2>
    <p>
      Als Diensteanbieter bin ich gemäß den allgemeinen Gesetzen für eigene Inhalte auf diesen Seiten
      verantwortlich. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte übernehme ich keine
      Gewähr über das gesetzlich Geschuldete hinaus.
    </p>

    <h2>Haftung für Links</h2>
    <p>
      Diese Website kann Links zu externen Websites Dritter enthalten. Auf deren Inhalte habe ich keinen
      Einfluss; deshalb kann ich für diese fremden Inhalte auch keine Gewähr übernehmen. Für die Inhalte der
      verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber verantwortlich.
    </p>

    <h2>Urheberrecht</h2>
    <p>
      Die auf dieser Website und in der App Kapitel erstellten Inhalte und Werke unterliegen dem deutschen
      Urheberrecht. Vervielfältigung, Bearbeitung, Verbreitung und jede Art der Verwertung außerhalb der
      Grenzen des Urheberrechts bedürfen der schriftlichen Zustimmung des jeweiligen Rechteinhabers.
    </p>
  </div>
</KapitelPage>
